# Series Radar API deployment settings.
# Copy this file to /opt/series-radar-api/env and fill in the secrets.
# The service reads it through EnvironmentFile= in the systemd unit.

SERIES_RADAR_HOME=/opt/series-radar-api
SERIES_RADAR_PORT=8090
SERIES_RADAR_CACHE=/opt/series-radar-api/cache
SERIES_RADAR_CACHE_MAX_AGE=2592000

# Preferred: put the token in /opt/series-radar-api/token (mode 600).
TMDB_TOKEN_FILE=/opt/series-radar-api/token
# Alternative: export the bearer token directly (do not commit it).
# TMDB_BEARER_TOKEN=

# Optional. OMDB's free tier is rate-limited; the app works without it.
OMDB_API_KEY=
