<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="رادار • فردا چه می‌آید؟"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#F5B301"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@drawable/widget_divider"
        android:showDividers="middle"
        android:dividerPadding="12dp" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="داده‌ای موجود نیست"
        android:textSize="12sp"
        android:textColor="#9AA6C9"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="به‌روزرسانی: —"
        android:textSize="10sp"
        android:textColor="#6D7AA3"
        android:gravity="center"
        android:layout_marginTop="8dp" />

</LinearLayout>