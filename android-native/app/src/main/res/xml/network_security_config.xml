<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks to the data API over HTTPS only. Cleartext is disabled for
     every host; older installed versions keep their own manifest. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
